{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "w-gl": [
        "./src/types/wgl.d.ts"
      ]
    }
  },
  "include": [
    "src/lib/data/**/*.ts",
    "src/proto/*.d.*",
    "tools/city-data/**/*.ts",
    "tests/*.test.ts"
  ]
}
