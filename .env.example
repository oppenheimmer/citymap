# Public settings are embedded at build time. Never put credentials in VITE_*.
# Public R2 delivery origin. Leave blank to serve only the cities bundled under
# /data (Monaco) and load every other city live from Overpass.
VITE_CITY_DATA_BASE_URL=
# Optional legacy version-1 cache.
VITE_AREA_SERVER=
# Defaults: same-origin /api/search and https://overpass-api.de/api/interpreter.
VITE_SEARCH_URL=
VITE_OVERPASS_URL=
# Optional independent backup for connection errors or HTTP 500/501, after backoff.
# No backup is used for rate limits, busy/resource errors or an explicit Retry-After.
# Candidate (verify connectivity before enabling): https://overpass.private.coffee/api/interpreter
VITE_OVERPASS_FALLBACK_URL=
# Bounded viewport loading is the default (unset or 1). Set 0 for whole-area rollback.
VITE_LIVE_VIEWPORT=1
# Live road requests in flight per browser session, 1-4, for a private Overpass server.
# Known public instances such as overpass-api.de always get 1, with viewport
# requests paced across map sessions and same-origin tabs.
VITE_OVERPASS_CONCURRENCY=

# Server-only search settings (Vercel environment or local .env.local).
# Default public Nominatim requires a private shared R2 search bucket in production.
SEARCH_PROVIDER_URL=https://nominatim.openstreetmap.org/search
SEARCH_PROVIDER_API_KEY=
APP_ORIGIN=
R2_SEARCH_BUCKET=citymap-search
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dataset bucket for batch publishing and optional server-side cache management.
R2_DATA_BUCKET=citymap-data

# Optional map-cache administration. Server only; never use a VITE_ prefix.
# Use a random secret of at least 32 characters. Enter it in Manage cached maps.
CACHE_ADMIN_TOKEN=
# Separate credentials with read/write/delete access to R2_DATA_BUCKET only.
R2_CACHE_ACCESS_KEY_ID=
R2_CACHE_SECRET_ACCESS_KEY=
