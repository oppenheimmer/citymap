{
  "name": "citymap",
  "version": "1.0.0",
  "description": "Visualization of all roads in a city",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:legacy && npm run prototype:build",
    "build:legacy": "vite build",
    "prototype:install": "npm ci --prefix prototype",
    "prototype:dev": "npm run dev --prefix prototype",
    "prototype:check": "npm run check --prefix prototype",
    "prototype:build": "npm run build --prefix prototype",
    "prototype:test": "npm test --prefix prototype",
    "prototype:benchmark": "npm run benchmark --prefix prototype",
    "preview": "vite preview --port 8080",
    "data:codegen": "node tools/city-data/codegen.mjs",
    "data:check": "tsc --project tsconfig.data.json",
    "data:build": "node tools/city-data/cli.ts build",
    "data:validate": "node tools/city-data/cli.ts validate",
    "data:pilot": "node tools/city-data/cli.ts pilot",
    "data:benchmark": "node tools/city-data/benchmark.ts",
    "test": "node --test tests/*.test.ts",
    "start": "vite",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "server:check": "tsc --project tsconfig.server.json"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.0.1",
    "d3-require": "^1.3.0",
    "ngraph.events": "^1.2.1",
    "pbf": "^3.2.1",
    "query-state": "^4.3.0",
    "tinycolor2": "^1.4.2",
    "vue": "^3.2.37",
    "w-gl": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pbf": "^3.0.5",
    "@vitejs/plugin-vue": "^2.3.1",
    "eslint": "^8.5.0",
    "eslint-plugin-vue": "^8.2.0",
    "rollup-plugin-visualizer": "^5.6.0",
    "stylus": "^0.58.1",
    "stylus-loader": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^2.9.5"
  }
}
