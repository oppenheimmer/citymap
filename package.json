{
  "name": "citymap",
  "version": "1.0.0",
  "description": "Visualization of all roads in a city",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run fixtures && vite",
    "build": "npm run fixtures && vite build",
    "preview": "vite preview --port 8080",
    "data:codegen": "node tools/city-data/codegen.mjs",
    "data:check": "tsc --project tsconfig.data.json",
    "data:build": "node tools/city-data/cli.ts build",
    "data:extract": "node tools/city-data/extract.ts",
    "data:validate": "node tools/city-data/cli.ts validate",
    "data:pilot": "node tools/city-data/cli.ts pilot",
    "data:benchmark": "node tools/city-data/benchmark.ts",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint .",
    "server:check": "tsc --project tsconfig.server.json",
    "fixtures": "node tools/browser-fixtures.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && npm run data:check && npm run server:check && npm run browser:check",
    "test:browser": "playwright test",
    "build:test": "VITE_TEST_FIXTURES=1 VITE_CITY_DATA_BASE_URL=http://127.0.0.1:4173/data npm run build",
    "data:publish": "node tools/city-data/publish.ts",
    "data:report": "node tools/city-data/report.ts",
    "benchmark:browser": "node tools/browser-benchmark.mjs",
    "deploy:check": "node tools/deployment-check.mjs",
    "browser:check": "tsc --project tsconfig.browser.json",
    "test:local:unit": "node --test --test-isolation=none tests/app-core.test.ts tests/load-city.test.ts tests/renderer-compat.test.ts tests/request.test.ts tests/response-body.test.ts tests/search.test.ts",
    "test:local:browser": "playwright test --config playwright.local.config.ts",
    "test:local": "npm run check && npm run lint && npm run test:local:unit && npm run test:local:browser"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.0.1",
    "pbf": "^3.2.1",
    "svelte": "^5.57.2",
    "w-gl": "0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.1",
    "@types/pbf": "^3.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.3"
  }
}
